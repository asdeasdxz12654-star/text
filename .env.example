# Example .env file - copy to .env and adjust values
BASE_URL=https://example.com
API_URL=https://api.example.com
AUTH_URL=https://example.com/auth

# Test credentials (local/dev only!)
TEST_USERNAME=test@example.com
TEST_PASSWORD=password123

# Browser options
BROWSER=chromium  # chromium, firefox, or webkit
HEADED=false      # set to true to see browser window
SLOWMO=0         # slow down actions by N milliseconds
TIMEOUT=5000     # default timeout in milliseconds

# Test behavior
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true
CLEANUP_TEST_DATA=true  # cleanup API test data after each test